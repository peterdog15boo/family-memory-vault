# =============================================================================
# Family Memory Vault — Environment Variables
#
#   cp .env.example .env.local
#
# Marked REQUIRED = needed to run the app locally or in production.
# Marked PRODUCTION = required (or strongly expected) for a live deploy.
# Everything else is optional / feature-gated.
#
# Never commit real secrets. Never expose server keys via NEXT_PUBLIC_*.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# REQUIRED — public site origin (no trailing slash). Used for invites, Stripe
# redirects, emails, and browser Origin checks on upload APIs.
# Local:  http://localhost:3000
# Prod:   https://your-domain.com   (must be https in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional alias used by some server helpers (prefer NEXT_PUBLIC_APP_URL)
# APP_URL=http://localhost:3000

# Optional comma-separated extra browser origins trusted for upload APIs
# (preview hosts, LAN IP while NEXT_PUBLIC_APP_URL stays localhost, etc.)
# Example: http://192.168.1.37:3000,https://preview.example.com
# ALLOWED_BROWSER_ORIGINS=

# Set automatically by Next / host platforms. Do not force "production" locally.
# NODE_ENV=development

# Structured logs: info (default) | debug
# LOG_LEVEL=info

# Local workers only — disables TLS cert verification (corporate proxies).
# Forbidden in production (boot check fails if set).
# ALLOW_INSECURE_TLS=false

# -----------------------------------------------------------------------------
# Authentication — Clerk  (REQUIRED)
# https://dashboard.clerk.com → API Keys
# Production: use pk_live_ / sk_live_ keys; enable secure cookies (HTTPS).
# Add your production domain under Clerk → Domains.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx

# Optional route overrides (defaults work with this repo’s /sign-in, /sign-up)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# -----------------------------------------------------------------------------
# Database — Neon Postgres + Drizzle  (REQUIRED)
# https://console.neon.tech
# Use the pooled URL for the app; unpooled for migrations / admin scripts.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# Object storage — Cloudflare R2  (REQUIRED)
# https://dash.cloudflare.com → R2
# Bucket must be PRIVATE. Serve media only via short-lived presigned URLs.
#
# CORS (browser PUT uploads) — allow your app origins, methods PUT/GET/HEAD,
# headers Content-Type / Content-Length / x-amz-* . Example AllowedOrigins:
#   http://localhost:3000
#   http://192.168.1.37:3000   ← needed for iPhone on Wi‑Fi
#   https://your-domain.com
# Apply with: npx tsx scripts/setup-r2-cors.ts
# (Requires an R2 token with PutBucketCORS. Dashboard works if API returns AccessDenied.)
# The app also falls back to POST/PUT /api/upload/put (same-origin proxy) when
# direct R2 CORS fails.
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=family-memory-vault
# If omitted, derived as https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_REGION=auto

# -----------------------------------------------------------------------------
# Workers / job drains  (PRODUCTION: REQUIRED)
# Background CLI: npm run worker:moderation | worker:faces | worker:movies
# Cron drain: POST /api/jobs/{moderation|faces|movies}
#   Authorization: Bearer <WORKER_SECRET>
#   (or header x-worker-secret)
# CRON_SECRET is accepted as an alias of WORKER_SECRET.
# -----------------------------------------------------------------------------
WORKER_SECRET=change_me_to_a_long_random_string
# CRON_SECRET=
WORKER_ENABLED=true
QUEUE_POLL_INTERVAL_MS=5000
QUEUE_MAX_ATTEMPTS=5
QUEUE_BATCH_SIZE=5
QUEUE_RETRY_DELAY_MS=30000
QUEUE_STALE_PROCESSING_MS=900000

# Movie worker overrides (optional)
# MOVIE_QUEUE_POLL_INTERVAL_MS=5000
# MOVIE_QUEUE_BATCH_SIZE=1
# MOVIE_QUEUE_RETRY_DELAY_MS=45000
# MOVIE_QUEUE_STALE_PROCESSING_MS=1200000
# MOVIE_DAILY_LIMIT=10
# MOVIE_ACTIVE_JOB_LIMIT=3
# FFMPEG_PATH=
# FFMPEG_BIN=

# Dev-only API tooling — hard-disabled when NODE_ENV=production
# ALLOW_DEV_MODERATE=false
# ALLOW_DEV_FACES=false

# -----------------------------------------------------------------------------
# Admins
# Prefer DB flag: npm run admin:promote -- --email=you@example.com
# Bootstrap: comma-separated Clerk user ids
# -----------------------------------------------------------------------------
ADMIN_USER_IDS=

# -----------------------------------------------------------------------------
# Assistant intent parsing (optional)
# OpenAI-compatible JSON chat for natural-language → structured intent.
# Without a key, the heuristic fallback parser is used.
# Also accepts Neon AI Gateway / Databricks-compatible base URLs.
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# AI_INTENT_MODEL=gpt-4o-mini
# Vision model for photo captions/tags/objects (Ask AI visual search). Defaults to gpt-4o-mini.
# AI_VISION_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=
# NEON_AI_API_KEY=

# -----------------------------------------------------------------------------
# AI moderation  (PRODUCTION: strongly recommended)
# Enable live vendor calls; otherwise the pipeline uses MODERATION_MOCK_SCENARIO.
# Provider: rekognition | google_vision | hive
# -----------------------------------------------------------------------------
AI_MODERATION_ENABLED=false
AI_MODERATION_PROVIDER=rekognition

# AWS Rekognition (moderation + optional face detection)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# REKOGNITION_ACCESS_KEY_ID=
# REKOGNITION_SECRET_ACCESS_KEY=
# REKOGNITION_REGION=us-east-1
# REKOGNITION_MIN_CONFIDENCE=50

# Google Cloud Vision
# GOOGLE_VISION_API_KEY=
# GOOGLE_VISION_API_URL=https://vision.googleapis.com/v1/images:annotate

# Hive
# HIVE_API_KEY=
# HIVE_API_URL=https://api.thehive.ai/api/v2/task/sync

# -----------------------------------------------------------------------------
# PhotoDNA — CSAM hash matching  (PRODUCTION: strongly recommended)
# https://www.microsoft.com/en-us/photodna
# -----------------------------------------------------------------------------
PHOTODNA_ENABLED=false
PHOTODNA_API_URL=https://api.microsoftmoderator.com/photodna/v1.0/Match
PHOTODNA_API_KEY=
# PHOTODNA_ENHANCE=false
# PHOTODNA_MATCH_MODE=binary

# -----------------------------------------------------------------------------
# NCMEC CyberTipline  (keep disabled until legal + ESP approval)
# Production API: https://report.cybertip.org/ispws
# Test API:       https://exttest.cybertip.org/ispws
# -----------------------------------------------------------------------------
NCMEC_REPORTING_ENABLED=false
NCMEC_CYBERTIPLINE_USERNAME=
NCMEC_CYBERTIPLINE_PASSWORD=
NCMEC_CYBERTIPLINE_ORG_ID=
NCMEC_CYBERTIPLINE_API_URL=https://exttest.cybertip.org/ispws

# -----------------------------------------------------------------------------
# Moderation pipeline (dev / staging)
# Mock scenarios when live PhotoDNA/AI are off:
#   clean | adult | csam | rejected | review | violence | violence_review
# Force status is IGNORED in production (boot check fails if set).
# -----------------------------------------------------------------------------
MODERATION_MOCK_SCENARIO=clean
# MODERATION_FORCE_STATUS=
# ALLOW_MODERATION_FORCE=false   # ignored / rejected in production

# Optional decision thresholds (0–1) — see SAFETY.md
# MODERATION_AI_CSAM_QUARANTINE_THRESHOLD=0.85
# MODERATION_AI_CSAM_REVIEW_THRESHOLD=0.55
# MODERATION_AI_NUDITY_REJECT_THRESHOLD=0.95
# MODERATION_AI_NUDITY_ADULT_THRESHOLD=0.70
# MODERATION_AI_NUDITY_REVIEW_THRESHOLD=0.40
# MODERATION_AI_VIOLENCE_REJECT_THRESHOLD=0.90
# MODERATION_AI_VIOLENCE_REVIEW_THRESHOLD=0.55
# MODERATION_ADULT_POLICY=adult

# -----------------------------------------------------------------------------
# Face detection (optional)
# Runs on clean/ready photos only. Same AWS/Google keys as moderation when used.
# -----------------------------------------------------------------------------
FACE_DETECTION_ENABLED=false
FACE_DETECTION_PROVIDER=rekognition
# FACE_DETECTION_MIN_CONFIDENCE=80
# FACE_GROUPING_MATCH_THRESHOLD=0.72
# FACE_GROUPING_MERGE_THRESHOLD=0.85
# FACE_IDENTITY_MATCHING=true
# FACE_IDENTITY_MATCH_THRESHOLD=95

# Scene / visual analysis for Ask AI (OpenAI vision preferred; Rekognition DetectLabels fallback).
# Defaults on when OPENAI_API_KEY and/or AWS creds exist. Set false to disable.
# SCENE_ANALYSIS_ENABLED=true
# AI_VISION_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Stripe billing (optional — Free plan works without Stripe)
# Webhook URL: https://your-domain.com/api/stripe/webhook
# Use the webhook signing secret from Stripe Dashboard (whsec_...), NOT the
# CLI secret, in production. Local: stripe listen --forward-to localhost:3000/api/stripe/webhook
# When STRIPE_SECRET_KEY is set, STRIPE_WEBHOOK_SECRET is REQUIRED in production.
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_live_xxxxxxxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# STRIPE_PRICE_FAMILY_MONTHLY=price_xxxxxxxx
# STRIPE_PRICE_FAMILY_YEARLY=price_xxxxxxxx
# STRIPE_PRICE_FAMILY_PLUS_MONTHLY=price_xxxxxxxx
# STRIPE_PRICE_FAMILY_PLUS_YEARLY=price_xxxxxxxx

# -----------------------------------------------------------------------------
# Transactional email — Resend (optional)
# Without RESEND_API_KEY, messages are logged instead of sent.
# Auth emails stay with Clerk.
# -----------------------------------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM="Family Memory Vault <hello@yourdomain.com>"

# -----------------------------------------------------------------------------
# AI movie soundtracks (optional) — ElevenLabs Music (official API)
# Docs: docs/AI_SOUNDTRACK.md
# Do not use unofficial Suno wrappers. Prefer ELEVENLABS_API_KEY.
# -----------------------------------------------------------------------------
# ELEVENLABS_API_KEY=sk_xxxxxxxx
# AI_MUSIC_PROVIDER=elevenlabs
# ELEVENLABS_MUSIC_MODEL=music_v1
# ELEVENLABS_API_BASE=https://api.elevenlabs.io
# ELEVENLABS_MUSIC_TIMEOUT_MS=180000
# AI_SOUNDTRACK_MAX_DURATION_MS=180000
# Future official Suno partner only (stub until implemented):
# SUNO_PARTNER_API_KEY=
